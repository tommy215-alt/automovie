{
  "permissions": {
    "allow": [
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "ToolSearch"
    ],
    "deny": [
      "Read(publish/token.json)",
      "Read(publish/client_secret*.json)",
      "Edit(publish/token.json)",
      "Edit(publish/client_secret*.json)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Format-Volume*)"
    ]
  }
}
